# ── CreatorBloom Environment Variables ──
# Copy this file to .env and fill in your values

# Authentication
JWT_SECRET=your-jwt-secret-here

# Email (Resend + Gmail SMTP fallback)
RESEND_API_KEY=re_xxxxx
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_STUDIO_PRICE_ID=price_xxxxx

# AI (OpenAI)
OPENAI_API_KEY=sk-xxxxx

# App
APP_URL=http://localhost:3001
DEMO_ACCESS_CODE=creatorbloom2026

# Google / YouTube Integration
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/youtube/callback

# Google / Gmail Integration
GOOGLE_GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback

# Meta (Instagram + Facebook) Integration
META_APP_ID=xxxxx
META_APP_SECRET=xxxxx
META_REDIRECT_URI=http://localhost:3001/api/integrations/meta/callback

# TikTok Integration
TIKTOK_CLIENT_KEY=xxxxx
TIKTOK_CLIENT_SECRET=xxxxx
TIKTOK_REDIRECT_URI=http://localhost:3001/api/integrations/tiktok/callback
